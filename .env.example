# Thittam — Local Development Environment
# Copy to .env.local and adjust as needed.
# DO NOT commit .env.local — it is gitignored.
#
# All secrets come from environment variables (Rule #2).
# No defaults for production secrets — fail fast at startup.

# ── Database ──────────────────────────────────────────────
# Option A (recommended): system PostgreSQL — data persists across reboots.
#   First run: make db-init
DATABASE_URL=postgres://thittam:thittam_dev@localhost:5433/thittam?sslmode=disable

# Option B: Docker PostgreSQL — run 'make infra-up-full' instead of 'make infra-up'.
#   Data lives in a Docker volume; wiped by 'docker compose down -v'.
# DATABASE_URL=postgres://thittam:thittam_dev@localhost:5434/thittam?sslmode=disable

# ── Redis ─────────────────────────────────────────────────
# Port 6380 avoids conflict with StudyBuddy's Redis on 6379.
REDIS_URL=redis://localhost:6380/0

# ── NATS JetStream ────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── MinIO / S3-compatible Object Storage ─────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=thittam
S3_SECRET_KEY=thittam_dev
S3_BUCKET=thittam-documents
S3_REGION=ap-south-1

# ── IAM / JWT ─────────────────────────────────────────────
# Generate keys with:
#   openssl genrsa -out keys/jwt_private.pem 2048
#   openssl rsa -in keys/jwt_private.pem -pubout -out keys/jwt_public.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_ACCESS_TOKEN_TTL=3600        # seconds (1 hour)
JWT_REFRESH_TOKEN_TTL=2592000    # seconds (30 days)

# ── Observability ─────────────────────────────────────────
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Notifications — use sandbox/test keys locally ─────────
# Email (SendGrid)
SENDGRID_API_KEY=SG.replace_with_sandbox_key

# SMS (Twilio)
TWILIO_ACCOUNT_SID=AC_replace_with_test_sid
TWILIO_AUTH_TOKEN=replace_with_test_token
TWILIO_FROM_NUMBER=+15005550006   # Twilio magic test number

# Push (FCM) — leave empty to disable push locally
FCM_SERVER_KEY=

# ── Demo / Dev convenience ────────────────────────────────
# Default tenant for single-tenant local dev (XYZ_CBA Productions)
DEV_TENANT_ID=d0000000-0000-0000-0000-000000000001
