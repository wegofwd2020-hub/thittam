{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wegofwd2020/thittam/pkg/vertical/schema.json",
  "title": "Thittam Vertical Plugin Definition",
  "description": "Schema for a Thittam vertical plugin YAML file. Each file describes a single industry vertical (e.g. movie-production, software-development). The file must have a top-level `vertical:` key.",
  "type": "object",
  "required": ["vertical"],
  "additionalProperties": true,
  "properties": {
    "vertical": {
      "type": "object",
      "description": "Top-level vertical definition block.",
      "required": [
        "id", "name", "version",
        "entity_labels", "phase_types", "budget_categories",
        "expense_categories", "inventory_categories",
        "default_chart_of_accounts", "report_definitions"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Stable kebab-case identifier. Must be unique across all registered verticals. Never changes after publication.",
          "examples": ["movie-production", "software-development"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable name shown in the UI."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version (MAJOR.MINOR.PATCH). Increment MAJOR when making breaking changes to phase graph or required fields.",
          "examples": ["1.0.0", "2.1.0"]
        },
        "description": {
          "type": "string",
          "description": "One-sentence description shown in the vertical picker."
        },
        "entity_labels": {
          "type": "object",
          "description": "Industry-specific labels that replace generic terms (e.g. 'Project' → 'Production'). All eight fields are required.",
          "required": [
            "project", "project_plural",
            "phase", "phase_plural",
            "team_member", "team_member_plural",
            "rate_label", "rate_unit"
          ],
          "additionalProperties": false,
          "properties": {
            "project":          { "type": "string", "minLength": 1 },
            "project_plural":   { "type": "string", "minLength": 1 },
            "phase":            { "type": "string", "minLength": 1 },
            "phase_plural":     { "type": "string", "minLength": 1 },
            "team_member":      { "type": "string", "minLength": 1 },
            "team_member_plural": { "type": "string", "minLength": 1 },
            "rate_label":       { "type": "string", "minLength": 1 },
            "rate_unit": {
              "type": "string",
              "enum": ["day", "hour", "month", "fixed"],
              "description": "Unit used on crew rate cards."
            }
          }
        },
        "phase_types": {
          "type": "array",
          "description": "Ordered list of project lifecycle phases. Must form a directed acyclic graph with at least one terminal node (allowed_transitions: []).",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "order", "allowed_transitions"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "Stable snake_case identifier. Referenced by allowed_transitions."
              },
              "label":  { "type": "string", "minLength": 1 },
              "order":  { "type": "integer", "minimum": 1 },
              "is_billable": {
                "type": "boolean",
                "default": false,
                "description": "True if expenses during this phase are billable to a client."
              },
              "allowed_transitions": {
                "type": "array",
                "items": { "type": "string" },
                "description": "IDs of phases this phase can transition to. Empty array = terminal state."
              }
            }
          }
        },
        "budget_categories": {
          "type": "array",
          "description": "Cost categories used when building a production budget. At least one required.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label":       { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "default_account_code": {
                "type": "string",
                "description": "Must reference a code in default_chart_of_accounts."
              }
            }
          }
        },
        "budget_templates": {
          "type": "array",
          "description": "Pre-built budget structures that can be applied to new projects. Optional.",
          "items": {
            "type": "object",
            "required": ["name", "line_items"],
            "additionalProperties": false,
            "properties": {
              "name":        { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "line_items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["category_id", "description"],
                  "additionalProperties": false,
                  "properties": {
                    "category_id": {
                      "type": "string",
                      "description": "Must reference an id in budget_categories."
                    },
                    "description":    { "type": "string" },
                    "account_code": {
                      "type": "string",
                      "description": "Must reference a code in default_chart_of_accounts."
                    },
                    "default_amount": { "type": "number", "minimum": 0 },
                    "is_required":    { "type": "boolean", "default": false }
                  }
                }
              }
            }
          }
        },
        "expense_categories": {
          "type": "array",
          "description": "Categories for submitted expense claims. At least one required.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "tax_treatment"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": { "type": "string", "minLength": 1 },
              "tax_treatment": {
                "type": "string",
                "enum": ["input_gst", "tds_applicable", "none"],
                "description": "GST/TDS treatment for expenses in this category."
              },
              "default_account_code": {
                "type": "string",
                "description": "Must reference a code in default_chart_of_accounts."
              },
              "requires_po": {
                "type": "boolean",
                "default": false,
                "description": "If true, a purchase order must be linked before submitting."
              }
            }
          }
        },
        "approval_workflow": {
          "type": "object",
          "description": "Role-based approval limits and dual-approval threshold.",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "array",
              "description": "Per-role maximum approvable amount (INR). Amounts exceeding a role's limit require a role with a higher limit.",
              "items": {
                "type": "object",
                "required": ["role", "max_amount"],
                "additionalProperties": false,
                "properties": {
                  "role":       { "type": "string", "minLength": 1 },
                  "max_amount": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            },
            "dual_approval_above": {
              "type": "number",
              "minimum": 0,
              "description": "Amounts above this threshold require two approvers regardless of role."
            }
          }
        },
        "inventory_categories": {
          "type": "array",
          "description": "Equipment and asset categories. At least one required.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": {
              "id":    { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "label": { "type": "string", "minLength": 1 },
              "is_trackable": {
                "type": "boolean",
                "default": false,
                "description": "If true, individual assets in this category have checkout/check-in tracking."
              },
              "depreciation_years": {
                "type": ["integer", "null"],
                "minimum": 1,
                "description": "Straight-line depreciation period. Null = non-depreciating."
              }
            }
          }
        },
        "default_chart_of_accounts": {
          "type": "array",
          "description": "Seed chart of accounts for new tenants using this vertical. Account codes referenced by budget_categories and expense_categories must appear here.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "name", "account_type"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Unique account code within this vertical (e.g. '5100')."
              },
              "name":  { "type": "string", "minLength": 1 },
              "account_type": {
                "type": "string",
                "enum": ["asset", "liability", "equity", "revenue", "expense"]
              },
              "parent_code": {
                "type": ["string", "null"],
                "description": "Code of the parent account for sub-accounts. Null = top-level."
              }
            }
          }
        },
        "report_definitions": {
          "type": "array",
          "description": "Report types available for this vertical. At least one required.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": false,
            "properties": {
              "id":          { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "name":        { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "data_sources": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Service names that contribute data to this report."
              },
              "default_columns": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "custom_fields": {
          "type": "object",
          "description": "Additional tenant-configurable fields for project and expense forms. Optional.",
          "additionalProperties": false,
          "properties": {
            "project": {
              "type": "array",
              "items": { "$ref": "#/$defs/custom_field" }
            },
            "expense": {
              "type": "array",
              "items": { "$ref": "#/$defs/custom_field" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "custom_field": {
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key":      { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label":    { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["text", "number", "date", "select", "boolean"]
        },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Required when type=select."
        },
        "required": { "type": "boolean", "default": false }
      }
    }
  }
}
