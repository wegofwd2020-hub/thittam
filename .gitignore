.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test artifacts
coverage.out
*.test

# Environment
.env
.env.local

# Local dev keys — generated by `make dev-keys`, never committed
keys/*.pem
keys/*.key
infra/local/keys/*.pem

# Dev service logs — written by scripts/dev-start.sh
logs/

# Proto docs output — regenerated by buf.gen.docs.yaml, shipped to thittam_docs
generated-docs/

# Agent orchestration: keep workflow state (config + manifest + ledger) for the
# PROGRESS.md "in flight" section, but ignore the regenerated task briefs.
.orchestration/task-*.md
!.orchestration/classifier.json
!.orchestration/manifest.json
!.orchestration/.orchestration.json

# python bytecode from the progress generator/tests
__pycache__/
*.pyc
